<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <Authors>LVGL</Authors>
    <Copyright>© LVGL. All rights reserved.</Copyright>
    <Version>9.6.0.0</Version>
    <MileDotNetHelpersEnableTextHelpers>true</MileDotNetHelpersEnableTextHelpers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
    <PackageReference Include="Mile.DotNet.Helpers" Version="1.0.71" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <Target Name="LvglBuildTasksAfterBuild" AfterTargets="Build">
    <Copy OverwriteReadOnlyFiles="true" SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\LvglPlatform\" />
  </Target>

</Project>
